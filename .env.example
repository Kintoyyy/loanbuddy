# Copy this file to .env and fill in values. Never commit real secrets.

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_NAME=loanbuddy-tunnel
DOMAIN=yourdomain.example.com

# Frontend
REACT_APP_API_BASE_URL=https://api.${DOMAIN}

# Backend / Supabase (examples — keep real secrets out of git)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_JDBC_URL=

# Minio credentials (used by MinIO and backend)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000

# App configuration
APP_CORS_ALLOWED_ORIGINS=https://${DOMAIN}

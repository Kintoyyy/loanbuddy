<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Draw signature below"
        android:textColor="@color/zinc_500"
        android:textSize="13sp" />

    <com.example.loanbuddy.ui.SignaturePadView
        android:id="@+id/signature_pad"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_signature_pad" />

    <Button
        android:id="@+id/btn_clear_sig"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_gravity="end"
        android:backgroundTint="@color/zinc_100"
        android:text="Clear"
        android:textColor="@color/zinc_600"
        android:textSize="12sp"
        style="@style/Widget.MaterialComponents.Button" />

</LinearLayout>

<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.LoanBuddy" parent="Theme.Material3.DayNight.NoActionBar" />
    <style name="Theme.LoanBuddy" parent="Base.Theme.LoanBuddy" />

    <!-- Primary full-width button: zinc_900 fill -->
    <style name="Btn.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/zinc_900</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Card action buttons (small, tinted fill) -->
    <style name="Btn.CardAction" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Filter tab: active -->
    <style name="Btn.Filter.Active" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/zinc_900</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Filter tab: inactive -->
    <style name="Btn.Filter.Inactive" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/zinc_500</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Destructive action button -->
    <style name="Btn.Destructive" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/rose_100</item>
        <item name="android:textColor">@color/rose_600</item>
        <item name="cornerRadius">10dp</item>
    </style>
</resources>
